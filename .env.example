PORT=5000
NODE_ENV=development

# Use either DATABASE_URL or the DB_* values below.
# For Render from your local machine, use the External Database URL, not the Internal Database URL.
DATABASE_URL=
DB_SSL=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=liastute_db
DB_USER=postgres
DB_PASSWORD=
SESSION_SECRET=change_this_session_secret

# JWT auth
JWT_SECRET=change_this_jwt_secret
JWT_EXPIRES_IN=7d

RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
ORDER_EMAIL=maxmark722@gmail.com

# Cloudinary image uploads
# Full endpoint format: CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
